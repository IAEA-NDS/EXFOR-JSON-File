          "TITLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Measurements of neutron capture cross-sections for",
                "nuclides of interest in decommissioning (IV) :",
                "165Ho(n, gamma) 166m, 166gHo reactions"
              ]
            }
          ],
          "AUTHOR": [
            {
              "pointer": "",
              "coded_information": [
                "S.Nakamura",
