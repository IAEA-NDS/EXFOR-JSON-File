          "INC-SPECT": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "The primary beam of 9Be was delivered by the",
                "Tandem-Linac accelerator at an energy of 40.9 MeV.",
                "The beam bombarded a thin-window gas cell filled with",
                "deuterium gas at 350 Torr, which was kept at liquid",
                "nitrogen temperature inside the RESOLUT radioactive",
                "beam facility. The magnetic and electric elements of",
                "RESOLUT were used to select a beam of 10Be produced",
                "via the 9Be(d,p)10Be reaction, with a beam purity",
                ">= 90%, at a rate of about ~6000 particles per",
                "second."
              ]
            }
          ],
          "DETECTOR": [
            {
              "pointer": "",
              "coded_information": [
                "IOCH",
                "SI",
                "TELES"
              ],
              "free_text": [
                " The heavy reaction residues and the",
                "unreacted beam were detected in an ionization chamber",
                "placed 25.4 cm downstream from the target position,",
                "filled with isobutane gas at 136 Torr. The light",
                "charged particles were detected in a set of S1 and S2",
                "type double-sided silicon detectors of thickness 68 and",
                " 1000 microm, respectively, placed in a forward dE-E",
                "telescope configuration at a distance of 8.6 and",
                "15.6 cm, respectively, from the target, covering a",
                "combined angular range of thetalab = 7-22 degrees."
              ]
            }
          ],
          "SAMPLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "A 517 microg/cm2 thick CD2 target."
              ]
            }
          ],
          "METHOD": [
            {
              "pointer": "",
              "coded_information": [
                "EDE"
              ],
              "free_text": [
                " The secondary beam of 10Be with an energy of",
                "39 MeV was focused into the reaction chamber and onto",
                "a CD2 target. A near-threshold proton resonance in 11B",
                "was observed via the reaction 10Be(d,n)11B -> 10Be + p",
                "in inverse kinematics."
              ]
            }
          ],
