          "INC-SPECT": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Typical alpha-beam intensities between 100 and 150",
                "microA were used during the experiment. To reduce",
                "possible target deterioration the beam spot was",
                "defocused to 2 cm2. Target deterioration after an",
                "accumulated total charge of 3.0 C resulted in an",
                "approximate reduction of 15% for the total yield and",
                "of 25% in the target thickness."
              ]
            }
          ],
          "DETECTOR": [
            {
              "pointer": "",
              "coded_information": [
                "GE"
              ],
              "free_text": [
                " A large volume (35%) Ge detector was positioned",
                "at an angle of 55 degree with respect to the beam",
                "direction and with a distance of 2.5 cm between the",
                "front face of the detector and the target."
              ]
            }
          ],
          "SAMPLE": [
            {
              "pointer": "",
              "coded_information": {
                "nuclide": "8-O-18",
                "field_identifier": "ENR",
                "value": 0.97
              },
              "free_text": [
                " Several targets with different",
                "thicknesses were produced by anodizing 0.5 mm thick",
                "Ta sheets in 97% enriched 180 water."
              ]
            }
          ],
          "METHOD": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "The 18O(alpha,gamma)22Ne reaction has been studied",
                "in the energy range between 340 and 800 keV to",
                "determine the existence of possible resonances and",
                "their influence on astrophysical reaction rates."
              ]
            }
          ],
          "ANALYSIS": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "The 660 keV resonance for gamma-ray energies above",
                "7.5 MeV after an accumulated total charge of 1.0 C",
                "was considered. The ground-state decay and the decay",
                "to the first excited state at 1.275 MeV have been",
                "analyzed and branching of 66+-5% and 34+-5%,",
                "respectively, were obtained. The total resonance",
                "strength was determined to be wgamma = 212+-42 microeV."
              ]
            }
          ],
