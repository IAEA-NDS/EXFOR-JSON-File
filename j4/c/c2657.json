          "TITLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "First spectral measurement of deuterium-tritium",
                "fusion gamma rays in inertial fusion experiments"
              ]
            }
          ],
          "AUTHOR": [
