          "DETECTOR": [
            {
              "pointer": "",
              "coded_information": [
                "NAICR"
              ],
              "free_text": [
                " SuN is a 4pi calorimeter, 16 inch in diameter",
                "and 16 inch long, that consists of two semicylinders",
                "to detect gamma rays with high efficiency. Each",
                "semicylinder is segmented into four optically",
                "isolated NaI(Tl) crystals, with three photomultipliers",
                " (PMTs) attached to each crystal. SuN has a borehole",
                "along its axis that is 1.8 inch in diameter. The",
                "large angular coverage and the high detection",
                "efficiency make SuN ideal for the application of the",
                "gamma-summing technique."
              ]
            }
          ],
          "SAMPLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "The target consisted of a 4-cm-long gas cell placed",
                "at the geometrical center of the SuN detector. The",
                "gas cell had a 2-microm-thick Mo foil on the front and",
                "back to contain the hydrogen gas. The pressure inside",
                "the gas cell was kept at ~600 Torr."
              ]
            }
          ],
          "METHOD": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "The experiment was conducted in inverse kinematics",
                "where a stable beam of 84Kr27+ was accelerated at",
                "energies 2.8, 3.1, 3.4, and 3.7 MeV/u and impinged",
                "onto a gas target of hydrogen. The gamma-rays from",
                "the nuclear reaction 84Kr+p -> 85Rb* originating",
                "from the deexcitation of the compound nucleus were",
                "registered by the Summing NaI(Tl) (SuN) detector."
              ]
            }
          ],
          "CORRECTION": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "To correct for the Doppler peak broadening,",
                "Doppler-shift corrections were applied on each segment."
              ]
            }
          ],
