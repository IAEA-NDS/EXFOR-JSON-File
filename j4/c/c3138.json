          "ANALYSIS": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "The double differential cross section was",
                "reconstructed for scattering angles of 3-6 degrees",
                "and excitation energies up to 26 MeV. A resolution of",
                "2.1 MeV full width at half maximum (FWHM) was",
                "achieved for the reconstructed excitation energy.",
                "Total cross section resulting from the sum of the two",
                "settings (13N and 12C fragments). The random",
                "coincidences were subtracted."
              ]
            }
          ],
