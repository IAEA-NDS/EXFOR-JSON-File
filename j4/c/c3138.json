          "INC-SOURCE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "A secondary 14O beam was produced by fragmentation of",
                "a 150 MeV/u 16O primary beam from the NSCL Coupled",
                "Cyclotron Facility (CCF) on a 1316 mg/cm2 thick 9Be",
                "production target placed at the entrance of the A1900",
                "fragment separator. A 70%-pure 105 MeV/u 14O beam with",
                "an intensity ranging from 200 to 700 kpps was generated",
                " by using a 150-mg/cm2 thick Al degrader in the A1900",
                "fragment separator. The main contaminants were 13N",
                "and 12C, accounting for 23% and 7%, respectively."
              ]
            }
          ],
          "DETECTOR": [
            {
              "pointer": "",
              "coded_information": [
                "TPC",
                "MAGSP"
              ],
              "free_text": [
                " The AT-TPC (Active-Target Time Projection",
                "Chamber) was filled with pure deuterium gas at a",
                "pressure of 530 Torr."
              ]
            }
          ],
          "METHOD": [
            {
              "pointer": "",
              "coded_information": [
                "TOF"
              ],
              "free_text": [
                " The time-of-flight (ToF) between two",
                "scintillators located at the exit of the A1900 and",
                "the entrance of the S800 spectrograph beam line (S800",
                "object point) was used to separate the 14O beam from",
                "the contaminants on an event-by-event basis. The beam",
                "was transported achromatically to the AT-TPC installed",
                "at the pivot point of the S800 spectrograph."
              ]
            }
          ],
          "CORRECTION": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Corrections for efficiency and acceptance were",
                "implemented through simulations using the ATTPCROOT",
                "analysis and simulation package."
              ]
            }
          ],
