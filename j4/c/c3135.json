          "ANALYSIS": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Through the current experiment, the 9844 keV, 10137",
                "keV, 10208.5 keV, and possibly a combination of the",
                "10280.4 keV and 10294.8 keV states in 22Ne were",
                "populated. These states correspond to the 217 keV,",
                "575 keV, 662.1 keV, 749.9 keV, and 767.6 keV",
                "resonances. The angular dependency of the",
                "differential cross section was used to determine the",
                "ln transfer by comparing experimental data to DWBA",
                "calculations."
              ]
            }
          ],
