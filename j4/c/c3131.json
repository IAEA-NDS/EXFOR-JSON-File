          "TITLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Study of the 25Mg(d,p)26Mg reaction to constrain the",
                "25Al(p,gamma)26Si resonant reaction rates in nova",
                "burning conditions"
              ]
            }
          ],
          "AUTHOR": [
            {
              "pointer": "",
              "coded_information": [
