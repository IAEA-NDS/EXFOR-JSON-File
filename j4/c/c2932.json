          "TITLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Cross sections for the production of radionuclides",
                "via natCu(p,X) spallation reactions for proton",
                "energies from 250 MeV to 2 GeV"
              ]
            }
          ],
          "AUTHOR": [
            {
              "pointer": "",
              "coded_information": [
                "P.N.Peplowski"
              ],
              "free_text": [
                ""
              ]
            }
          ],
          "REFERENCE": [
            {
              "pointer": "",
              "coded_information": {
                "code": "J,NP/A,1006,122067,2021",
                "code_unit": [
                  {
                    "unit": "J,NP/A,1006,122067,2021",
                    "doi": "10.1016/j.nuclphysa.2020.122067",
                    "field": {
                      "reference_type": "J",
                      "reference": {
                        "code": "NP/A",
                        "number": null,
                        "volume": "1006",
                        "part": null,
                        "issue": null,
                        "page": "122067"
                      },
                      "date": 2021
                    }
                  }
                ],
                "unit_combination": "(%)"
              },
              "free_text": [
                "",
                "#doi:10.1016/j.nuclphysa.2020.122067"
              ]
            }
          ],
          "INSTITUTE": [
            {
              "pointer": "",
              "coded_information": [
                "1USAJHU"
              ],
              "free_text": [
                ""
              ]
            }
          ],
          "FACILITY": [
            {
              "pointer": "",
              "coded_information": {
                "facility": [
                  "SYNCH"
                ],
                "institute": "1USABNL"
              },
              "free_text": [
                " The BNL Alternating Gradient",
                "Synchrotron (AGS) booster, Brookhaven National",
                "Laboratory's NASA Space Radiation Laboratory (NSRL)."
              ]
            }
          ],
          "INC-SPECT": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "The AGS beam bunches had width of 300-400 ms and",
                "proton fluence of ~10**6 protons cm-2 bunch-1."
              ]
            }
          ],
          "DETECTOR": [
            {
              "pointer": "",
              "coded_information": [
                "HPGE"
              ],
              "free_text": [
                " Gamma-ray emissions from the samples were",
                "characterized with a 7.4-cm-diameter by 6.8-cm-long",
                " (73.5% relative efficiency) HPGe detector."
              ]
            }
          ],
          "SAMPLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Targets of natural Cu (69.2% 63Cu, 30.8% 65Cu) were",
                "used for this experiment. The targets were 25 mm x 25",
                "mm square, 2-mm-thick foils with a purity 99.99+%.",
                "The manufacturer reports typical impurities (in ppm)",
                "of Ag (70), Fe (2), Ni (2), Pb (2), Si (2), Al (1),",
                "Bi (1), Ca (1), Mg (1), Sn (1), Cr (<1), Mn (<1),",
                "and Na (<1)."
              ]
            }
          ],
          "METHOD": [
            {
              "pointer": "",
              "coded_information": [
                "ACTIV"
              ],
              "free_text": [
                " The Cu foils were irradiated at NSRL. Beam",
                "bunches were pulled from the booster every 3.5 s and",
                "directed toward the NSRL beamline, where a series of",
                "quadrupole magnets shaped the beam to a uniform",
                "square of approximately 4x4 cm, which was larger than",
                "the 25x25 mm targets. A proton fluence of 1x10**10",
                "cm-2 was incident on each sample, requiring total",
                "irradiation times of between 4 and 9 min per target.",
                "Following the foil irradiations, the samples were",
                "returned to the Planetary Nuclear Spectroscopy",
                "Laboratory at the Johns Hopkins Applied Physics",
                "Laboratory (APL) for target activation measurements.",
                "The foil measurements occurred between 11 and 25 days",
                "after target irradiation."
              ]
            }
          ],
          "ERR-ANALYS": [
            {
              "pointer": "",
              "coded_information": {
                "heading": "DATA-ERR",
                "minimum_value": null,
                "maximum_value": null,
                "correlation_property": null
              },
              "free_text": [
                " 1-sigma statistical and systematic",
                "uncertainties. Per-channel statistical uncertainties",
                "were derived from the original (pre-continuum-",
                "subtraction) Poisson statistics of the two",
                "measurements. The energy-dependent intrinsic",
                "gamma-ray photopeak detection efficiency and",
                "measurement solid angle systematic uncertainties,",
                "were derived from Geant4 modeling of this gamma-ray",
                "counting station."
              ]
            }
          ],
          "CORRECTION": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "A small correction for gamma-ray scattering within",
                "the foil."
              ]
            }
          ],
