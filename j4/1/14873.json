          "TITLE": [
            {
              "pointer": "",
              "coded_information": null,
              "free_text": [
                "Average prompt fission neutron multiplicities",
                "measured in the 235U(n,F) reaction induced by",
                "neutrons of energy from 1 to 700 MeV"
              ]
            }
          ],
          "AUTHOR": [
            {
              "pointer": "",
              "coded_information": [
